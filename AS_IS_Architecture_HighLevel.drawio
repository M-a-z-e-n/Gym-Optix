        <mxCell id="fe_box" value="&lt;b&gt;React 19 Frontend Client (Web SPA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10.5px; line-height: 1.5;&quot;&gt;• Bootstrap 5 • React Router 7 • &lt;code&gt;useWebSocket.js&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Client Routes:&lt;/b&gt; &lt;code&gt;/&lt;/code&gt; (Main), &lt;code&gt;/user&lt;/code&gt;, &lt;code&gt;/admin&lt;/code&gt;, &lt;code&gt;/demo&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Features:&lt;/b&gt; Live Video Stream + Skeletal Pose Overlay,&lt;br&gt;  Real-time Exercise Classification, Repetition Count Badge&lt;/span&gt;" style="shape=rectangle;rounded=1;html=1;whiteSpace=wrap;strokeWidth=1.8;align=center;fontSize=11;fontColor=#FFFFFF;" parent="t4_lane" vertex="1">
          <mxGeometry x="30" y="265" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="legend_lane" value="&lt;b&gt;DIAGRAM LEGEND &amp;amp; DATAFLOW&lt;/b&gt;" style="swimlane;startSize=30;horizontal=0;html=1;whiteSpace=wrap;strokeWidth=2;rounded=1;fontStyle=1;fontSize=12;container=1;collapsible=0;pointerEvents=0;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="2230" y="105" width="280" height="635" as="geometry" />
        </mxCell>
        <mxCell id="legend_content" value="&lt;b&gt;Arrow Semantics:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;line-height:1.6;&quot;&gt;━━━▶ &lt;b&gt;Solid Line:&lt;/b&gt;&lt;br&gt;Direct Runtime Data Flow&lt;br&gt;&lt;br&gt;┄ ┄ ┄▶ &lt;b&gt;Dashed Line:&lt;/b&gt;&lt;br&gt;Asynchronous Decoupled Flow&lt;br&gt;or Cloud Deployment Link&lt;br&gt;&lt;br&gt;⮂ ⮂ ⮂▶ &lt;b&gt;Dual Direction:&lt;/b&gt;&lt;br&gt;Bidirectional Socket / REST Call&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Design Attributes:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; line-height: 1.5;&quot;&gt;• &lt;b&gt;Hollow Style:&lt;/b&gt; Clean, transparent academic presentation.&lt;br&gt;• &lt;b&gt;Corridors:&lt;/b&gt; 90px spacing prevents line overlaps.&lt;br&gt;• &lt;b&gt;Label Badges:&lt;/b&gt; Dataflow labels sit on white bordered badges for maximum legibility.&lt;/span&gt;" style="shape=rectangle;rounded=1;html=1;whiteSpace=wrap;strokeWidth=1;align=left;spacingLeft=12;spacingTop=10;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;" parent="legend_lane" vertex="1">
