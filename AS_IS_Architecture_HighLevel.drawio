        <mxCell id="db_box" value="&lt;b&gt;PostgreSQL Relational Database (Cloud SQL)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10.5px; line-height: 1.5;&quot;&gt;• &lt;b&gt;&lt;code&gt;exercise_plan&lt;/code&gt; Table:&lt;/b&gt; Workout routines, planned sets, reps&lt;br&gt;• &lt;b&gt;&lt;code&gt;log&lt;/code&gt; Table:&lt;/b&gt; Completed workout records, detected IDs, timestamps&lt;/span&gt;" style="shape=rectangle;rounded=1;html=1;whiteSpace=wrap;strokeWidth=1.8;align=center;fontSize=11;fontColor=#FFFFFF;" parent="t4_lane" vertex="1">
