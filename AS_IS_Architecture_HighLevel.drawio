        <mxCell id="ai_pose" value="&lt;b&gt;1. Pose Estimation (MediaPipe)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Extracts 33 3D Keypoints &amp;amp; Bounding Box&lt;/span&gt;" style="shape=rectangle;rounded=1;html=1;whiteSpace=wrap;strokeWidth=1.8;align=center;fontSize=11;fontColor=#FFFFFF;" parent="t3_lane" vertex="1">
